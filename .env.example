# Firebase web config — copy to .env.local and fill in from
# Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
# These values are NOT secrets (they ship in the client bundle); security is enforced
# by firestore.rules, not by hiding this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Domain appended to a bare login ID at sign-in.
# "ananya.r" -> "ananya.r@neommodular.com". Anything containing "@" is used as-is.
# Must match the email domain used when creating accounts in the Firebase Auth console.
#
# NOTE: neommodular.com publishes a null MX record (`dig +short MX neommodular.com`
# returns "0 ."), meaning it accepts no mail at all. Addresses on this domain are
# login identifiers only — Firebase's password-reset email cannot be delivered to
# them, so resets for those accounts go through an admin in the Firebase console.
# Users who sign in with a real, deliverable address get self-service reset.
VITE_LOGIN_DOMAIN=neommodular.com

# Set to "true" to point the app at the local Firebase emulators instead of production.
VITE_USE_EMULATORS=false
